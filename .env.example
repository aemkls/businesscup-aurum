# Google AI Studio key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=

# Optional: preferred model, tried first. Falls back to gemini-3.5-flash,
# gemini-3.1-flash-lite, then the -latest aliases.
GEMINI_MODEL=

# Stripe TEST mode secret key (sk_test_...). Without it the app unlocks paid
# content for free (demo mode).
STRIPE_SECRET_KEY=
# Optional: a Price from your Stripe dashboard. Without it Checkout charges an inline $19.
STRIPE_PRICE_ID=

# Loyalty card ("every 4th case is free"). Signs the stamp cookie and the free
# pass. Without it, or without STRIPE_SECRET_KEY, the loyalty card is off.
# Generate one with: openssl rand -hex 32
LOYALTY_SECRET=
